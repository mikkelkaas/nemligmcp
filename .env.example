# .env.example - copy to .env and fill in your own values. Never commit the real file.
#
# One file serves both halves of this repository: the MCP server (Docker) reads the
# credentials and the listen settings, and the planner (family-planner/*.mjs) reads the
# same credentials plus the optional lines at the bottom. The planner looks for this file
# in its own folder, then in the folder above it; NEMLIG_ENV points it somewhere else.
# Running `node family-planner/doctor.mjs` tells you which file it found.

# Your own Nemlig login. Omit both to run the server in anonymous mode: product search
# only, and the basket tools answer "login required". The planner needs both, because a
# plan reads your basket and your order history.
NEMLIG_USER=<your-login>
NEMLIG_PASS=<your-password>

# Guards the MCP endpoint and forms part of its URL path (/mcp/<MCP_SECRET>). The server
# refuses a non-loopback bind without it, or without MCP_ALLOW_UNAUTHENTICATED=1. It must
# be at least 32 characters: generate one with `openssl rand -hex 32`.
MCP_SECRET=<long-random-string>

# How the server listens. The compose file in this repo sets these same values.
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000

# Optional, read by the planner only. Un-comment what you need.
# NEMLIG_ENV=/path/to/the/.env/to/read      # instead of the search described above
# NEMLIG_MCP_URL=http://127.0.0.1:3000/mcp  # set alone: no container lookup happens
# NEMLIG_CONTAINER=<container-name>         # what your server container is called
# NEMLIG_NET=<network-name>                 # the network it answers on
# NEMLIG_FAMILY_PROFILE=<profile-name>      # which profiles/<name>.json to use by default
# NEMLIG_HOME=/path/to/family-planner       # keep data/ and profiles/ somewhere else
# NEMLIG_CONCURRENCY=4                      # 1-8 parallel shop calls
# NEMLIG_MAX_CALLS=120                      # a run stops at this many shop calls
# NEMLIG_MAX_MINUTES=8                      # a run stops after this much wall clock
